# syntax=docker/dockerfile:1
#
# The Node Agent is the only process that talks to the Docker daemon. It runs
# `git`, `docker` (with the buildx plugin) and `trivy` as child processes, so
# those binaries live in the image rather than being assumed on the host.
#
# ClamAV is deliberately not bundled: its virus database costs ~1 GB of RAM and
# disk on a node that also runs the platform, and the scanner already reports a
# missing binary as an informational finding instead of failing a Deployment.

FROM golang:1.27-bookworm AS build
WORKDIR /src
COPY agent/go.mod agent/go.sum ./
RUN go mod download
COPY agent/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -o /out/stealth-agent ./cmd/agent

# The Docker CLI image ships both `docker` and the buildx plugin that `docker
# build` delegates to since Docker 23.
FROM docker:cli AS dockercli
FROM aquasec/trivy:latest AS trivy

FROM debian:bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates git tini \
 && rm -rf /var/lib/apt/lists/*

COPY --from=dockercli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=dockercli /usr/local/libexec/docker/cli-plugins/docker-buildx \
     /usr/local/libexec/docker/cli-plugins/docker-buildx
COPY --from=trivy /usr/local/bin/trivy /usr/local/bin/trivy
COPY --from=build /out/stealth-agent /usr/local/bin/stealth-agent

ENV AGENT_ADDR=":8081" \
    AGENT_WORK_DIR="/var/lib/stealth-agent" \
    TRIVY_BIN="/usr/local/bin/trivy"

# The agent needs the Docker socket, which the host usually owns as root:docker.
# It runs as root because the socket group id differs per host and the agent is
# already trusted with the daemon; it publishes no ports.
RUN mkdir -p /var/lib/stealth-agent

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/stealth-agent"]
