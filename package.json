{
  "name": "app-steath",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:go": "cd agent && go test ./...",
    "test:all": "npm run test && npm run test:go && npm run contract:check",
    "contract:generate": "npm run contract:generate:ts && npm run contract:generate:go",
    "contract:generate:ts": "openapi-typescript contracts/agent.openapi.yaml -o contracts/generated/agent.d.ts",
    "contract:generate:go": "cd agent && go run github.com/oapi-codegen/oapi-codegen/v2/cmd/oapi-codegen@v2.8.2 -config ../contracts/oapi-codegen.yaml ../contracts/agent.openapi.yaml",
    "contract:check": "npm run contract:generate && git diff --exit-code -- contracts/generated agent/internal/api/generated.gen.go",
    "contract:breaking": "node scripts/check-contract-breaking.mjs",
    "ci": "npm run typecheck && npm run test:all",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f postgres",
    "auth:generate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-auth-schema.mts",
    "db:migrate": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/migrate.mts",
    "auth:migrate": "npm run db:migrate"
  },
  "dependencies": {
    "better-auth": "^1.7.18",
    "lucide-react": "^1.48.0",
    "motion": "^14.9.1",
    "next": "16.4.5",
    "openapi-fetch": "^0.17.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "openapi-typescript": "^7.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "ui-skills": "0.2.4",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.0": true,
    "sharp@0.34.5": true,
    "sharp@0.35.5": true,
    "workerd@1.20260114.0": true
  }
}
