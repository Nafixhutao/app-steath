@startuml
title Gambar 3 — Use Case Modul Organisasi, Tim, dan Kuota

left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F3ECFA
  BorderColor #6B4A80
  FontSize 12
}

actor "Customer" as C

rectangle "Stealth Hosting — Console (Control Plane)" {

  package "Identitas Organisasi" {
    usecase "UC-08\nMemperbarui Identitas\nOrganisasi" as UC08
    usecase "UC-13\nKeluar dari Organisasi" as UC13
    usecase "UC-14\nMenghapus Organisasi" as UC14
  }

  package "Manajemen Tim" {
    usecase "UC-09\nMengundang Anggota" as UC09
    usecase "UC-10\nMengubah Peran Anggota" as UC10
    usecase "UC-11\nMenghapus Anggota" as UC11
    usecase "UC-12\nMembatalkan Undangan" as UC12
  }

  package "Kuota" {
    usecase "UC-15\nMemantau Penggunaan\n& Kuota" as UC15
  }
}

C --> UC08
C --> UC09
C --> UC10
C --> UC11
C --> UC12
C --> UC13
C --> UC14
C --> UC15


@enduml
