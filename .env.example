# Environment Variables Reference

## Required for Development
DATABASE_URL="postgresql://stealth:stealth_dev_password@localhost:5432/stealth_hosting"
BETTER_AUTH_SECRET="development-secret-change-in-production-min-32-chars"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

## Required for Production (add to .env.local when deploying)
# BETTER_AUTH_SECRET="your-production-secret-min-32-characters"
# BETTER_AUTH_URL="https://yourdomain.com"
# RESEND_API_KEY="your_resend_api_key"

## Node Agent (Control Plane side)
# AGENT_BASE_URL="http://localhost:8081"
# AGENT_TOKEN="change-me"
# AGENT_NAME="node-1"

## Node Agent runtime (Node Agent side)
# CONTROL_PLANE_URL="http://localhost:3000"
# CADDY_ADMIN_URL="http://127.0.0.1:2019"
# CADDY_CONTAINER_NAME="stealth-caddy"
# AGENT_PROBE_IMAGE="busybox:1.36"

## Platform Subdomains
# PLATFORM_DOMAIN="127.0.0.1.nip.io"

## Optional
# NODE_ENV="development"
