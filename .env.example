# Environment Variables Reference
#
# Local development reads `.env.local`. The production stack reads `.env` next to
# `docker-compose.production.yml`; `scripts/wizard-vps.sh` writes the values it
# can generate into `.env.production`, which is then copied to the VPS.

## Required for Development
DATABASE_URL="postgresql://stealth:stealth_dev_password@localhost:5432/stealth_hosting"
BETTER_AUTH_SECRET="development-secret-change-in-production-min-32-chars"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

## Required for Production
# BETTER_AUTH_SECRET="your-production-secret-min-32-characters"
# BETTER_AUTH_URL="https://console.example.com"
# NEXT_PUBLIC_BETTER_AUTH_URL="https://console.example.com"   # inlined at build time
# POSTGRES_PASSWORD="database-password-for-the-platform-postgres"
# RESEND_API_KEY="your_resend_api_key"

## Node Agent (Control Plane side)
# AGENT_BASE_URL="http://agent:8081"
# AGENT_TOKEN="change-me"
# AGENT_NAME="node-1"

## Node Agent runtime (Node Agent side)
# AGENT_ADDR=":8081"
# AGENT_WORK_DIR="/var/lib/stealth-agent"
# CONTROL_PLANE_URL="http://control-plane:3000"
# CADDY_ADMIN_URL="http://caddy:2019"
# CADDY_CONTAINER_NAME="stealth-caddy"
# AGENT_PROBE_IMAGE="busybox:1.36"
# TRIVY_BIN="/usr/local/bin/trivy"

## Environment Variable encryption (Control Plane side)
# 32-byte key: 64 hex characters or base64 that decodes to exactly 32 bytes.
# Without it the Environment Variable API answers 503 encryption_not_configured.
# Generate one with: openssl rand -base64 32
# ENV_ENCRYPTION_KEY=""

## Platform domains
# PLATFORM_DOMAIN="apps.example.com"   # Platform Subdomains: <slug>-<id>.apps.example.com
# DASHBOARD_DOMAIN="console.example.com"
# PLATFORM_IP="203.0.113.10"           # A record a Custom Domain must point at
# PLATFORM_ADMIN_EMAILS="admin@example.com,ops@example.com"

## Cloudflare Tunnel (production ingress)
# The tunnel is created in the Cloudflare dashboard; its public hostnames point at
# https://caddy:443 with "No TLS Verify" enabled. No host port is published.
# CLOUDFLARE_TUNNEL_TOKEN=""

## Backups (optional, S3-compatible; local disk is the fallback)
# Without S3_* the artifact is written to BACKUP_LOCAL_DIR, which the compose file
# points at a Volume shared by the worker and the Control Plane.
# BACKUP_LOCAL_DIR="/app/backups"
# S3_ENDPOINT="http://rustfs:9000"
# S3_BUCKET="stealth-backups"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# BACKUP_LOCAL_DIR="/var/lib/stealth-agent/backups"

## Optional
# NODE_ENV="development"
# PLATFORM_DB_CONTAINER="stealth-postgres"
