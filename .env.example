# Environment Variables Reference
#
# Local development reads `.env.local`. The production stack reads `.env` next to
# `docker-compose.production.yml`; `scripts/wizard-vps.sh` writes the values it
# can generate into `.env.production`, which is then copied to the VPS.

## Required for Development
DATABASE_URL="postgresql://stealth:stealth_dev_password@localhost:5432/stealth_hosting"
BETTER_AUTH_SECRET="development-secret-change-in-production-min-32-chars"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

## Required for Production
# BETTER_AUTH_SECRET="your-production-secret-min-32-characters"
# BETTER_AUTH_URL="https://console.example.com"
# NEXT_PUBLIC_BETTER_AUTH_URL="https://console.example.com"   # inlined at build time
# POSTGRES_PASSWORD="database-password-for-the-platform-postgres"
# RESEND_API_KEY="your_resend_api_key"

## Node Agent (Control Plane side)
# AGENT_BASE_URL="http://agent:8081"
# AGENT_TOKEN="change-me"
# AGENT_NAME="node-1"

## Node Agent runtime (Node Agent side)
# AGENT_ADDR=":8081"
# AGENT_WORK_DIR="/var/lib/stealth-agent"
# CONTROL_PLANE_URL="http://control-plane:3000"
# CADDY_ADMIN_URL="http://caddy:2019"
# CADDY_CONTAINER_NAME="stealth-caddy"
# AGENT_PROBE_IMAGE="busybox:1.36"
# TRIVY_BIN="/usr/local/bin/trivy"

## Environment Variable encryption (Control Plane side)
# 32-byte key: 64 hex characters or base64 that decodes to exactly 32 bytes.
# Without it the Environment Variable API answers 503 encryption_not_configured.
# Generate one with: openssl rand -base64 32
# ENV_ENCRYPTION_KEY=""

## Platform domains
# PLATFORM_DOMAIN="example.com"        # Harus satu level di bawah zona: <slug>-<id>.example.com
# DASHBOARD_DOMAIN="console.example.com"
# PLATFORM_IP="203.0.113.10"           # A record a Custom Domain must point at
# PLATFORM_ADMIN_EMAILS="admin@example.com,ops@example.com"

## Self-hosted S3 (shared MinIO server)
# Root credentials for the MinIO server the Node Agent provisions tenant buckets
# into. The Agent is the only process that uses them; tenant applications get
# their own per-bucket IAM keys from the Storage dashboard. Generate the password
# with `openssl rand -hex 32` and keep it stable: changing it does not rotate
# tenant keys but does break the Agent's ability to manage buckets until updated.
# The public S3 hostname is `s3.<PLATFORM_DOMAIN>` and is routed by Caddy; add
# that hostname to the wildcard ingress rule that already serves *.PLATFORM_DOMAIN.
# MINIO_ROOT_USER="stealthminio"
# MINIO_ROOT_PASSWORD=""

## phpMyAdmin sign-in bridge
# The hostname phpMyAdmin is published on (defaults to pma.<PLATFORM_DOMAIN>). The
# Control Plane logs in here server-side so "Open phpMyAdmin" needs no typing, and
# the value must match the hostname Caddy serves or phpMyAdmin will not hand back a
# usable session cookie.
# PHPMYADMIN_HOSTNAME=""
# Address the Control Plane dials. Defaults to `caddy:443`: the login has to arrive
# over HTTPS with the public hostname as SNI, so a plain http://stealth-pma hop does
# not produce cookies the browser would send back.
# PHPMYADMIN_INTERNAL_URL=""

## Cloudflare Tunnel (production ingress)
# The tunnel is created in the Cloudflare dashboard; its public hostnames point at
# https://caddy:443 with "No TLS Verify" enabled. No host port is published.
# CLOUDFLARE_TUNNEL_TOKEN=""

## Backups (optional, S3-compatible; local disk is the fallback)
# S3_ENDPOINT="http://rustfs:9000"
# S3_BUCKET="stealth-backups"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# BACKUP_LOCAL_DIR="/var/lib/stealth-agent/backups"

## Optional
# NODE_ENV="development"
# PLATFORM_DB_CONTAINER="stealth-postgres"

## Redis (optional cache)
# The production compose runs a redis service on the internal network. When
# REDIS_URL is set, the admin Overview and Status Page report the Cache
# component from its real health and the worker stores its INFO samples.
# REDIS_URL="redis://redis:6379"

## Shared database servers
# Every Project Database is a schema inside one server per engine, started and
# owned by the Node Agent. These two passwords are the admin credentials the
# Agent uses to create and drop tenant roles. Generate each with `openssl rand
# -hex 32`; changing one after Databases exist makes those Databases unreachable
# until it is rotated through the dashboard.
# MYSQL_ROOT_PASSWORD=""
# PGDB_POSTGRES_PASSWORD=""
