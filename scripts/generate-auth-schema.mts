import { writeFileSync } from "node:fs";
import path from "node:path";
import type { BetterAuthOptions } from "better-auth";
import { getSchema } from "better-auth/db";
import { authConfig } from "../lib/auth-config.ts";

type FieldAttribute = {
  type: string;
  required?: boolean;
  unique?: boolean;
  index?: boolean;
  fieldName?: string;
  defaultValue?: unknown;
  references?: {
    model: string;
    field: string;
    onDelete?: "cascade" | "restrict" | "set null" | "no action";
  };
};

type Table = {
  fields: Record<string, FieldAttribute>;
  indexes?: ReadonlyArray<{ fields: readonly string[]; name?: string }>;
  order: number;
};

const schema = getSchema(authConfig as BetterAuthOptions) as Record<string, Table>;

function quote(identifier: string): string {
  return `"${identifier.replaceAll('"', '""')}"`;
}

function sqlType(field: FieldAttribute): string {
  switch (field.type) {
    case "string":
      return "text";
    case "number":
      return "double precision";
    case "boolean":
      return "boolean";
    case "date":
      return "timestamptz";
    case "json":
      return "jsonb";
    case "string[]":
      return "text[]";
    case "number[]":
      return "double precision[]";
    default:
      return "text";
  }
}

function sqlDefault(value: unknown): string | undefined {
  if (typeof value === "boolean") return value ? "TRUE" : "FALSE";
  if (typeof value === "number") return String(value);
  if (typeof value === "string") return `'${value.replaceAll("'", "''")}'`;
  if (value instanceof Date) return `'${value.toISOString()}'`;
  return undefined;
}

const tables = Object.entries(schema).sort(
  ([nameA, tableA], [nameB, tableB]) => tableA.order - tableB.order || nameA.localeCompare(nameB),
);

const statements: string[] = [
  "-- Generated by scripts/generate-auth-schema.mts from lib/auth-config.ts.",
  "-- Do not edit by hand. Run `npm run auth:generate` after changing auth plugins.",
  "",
];

const foreignKeys: string[] = [];
const indexes: string[] = [];

for (const [tableName, table] of tables) {
  const columns: string[] = [
    `  ${quote("id")} text PRIMARY KEY NOT NULL DEFAULT gen_random_uuid()`,
  ];

  for (const [fieldKey, field] of Object.entries(table.fields)) {
    const column = field.fieldName ?? fieldKey;
    let definition = `  ${quote(column)} ${sqlType(field)}`;

    if (field.required) definition += " NOT NULL";
    if (field.unique) definition += " UNIQUE";

    const defaultValue = sqlDefault(field.defaultValue);
    if (defaultValue !== undefined) definition += ` DEFAULT ${defaultValue}`;

    columns.push(definition);

    if (field.references) {
      const action = (field.references.onDelete ?? "no action").toUpperCase();
      foreignKeys.push(
        `ALTER TABLE ${quote(tableName)} ADD CONSTRAINT ${quote(
          `${tableName}_${column}_fk`,
        )} FOREIGN KEY (${quote(column)}) REFERENCES ${quote(
          field.references.model,
        )} (${quote(field.references.field)}) ON DELETE ${action};`,
      );
    }

    if (field.index && !field.unique) {
      indexes.push(
        `CREATE INDEX ${quote(`idx_${tableName}_${column}`)} ON ${quote(tableName)} (${quote(
          column,
        )});`,
      );
    }
  }

  statements.push(`CREATE TABLE ${quote(tableName)} (\n${columns.join(",\n")}\n);`, "");

  for (const index of table.indexes ?? []) {
    const name = index.name ?? `idx_${tableName}_${index.fields.join("_")}`;
    const columnsSql = index.fields.map((field) => quote(field)).join(", ");
    indexes.push(`CREATE INDEX ${quote(name)} ON ${quote(tableName)} (${columnsSql});`);
  }
}

statements.push(...foreignKeys, ...indexes);

const outputPath = path.join(process.cwd(), "database", "migrations", "0002_better_auth.sql");
writeFileSync(outputPath, `${statements.join("\n")}\n`);
console.log(`Wrote ${path.relative(process.cwd(), outputPath)}`);
process.exit(0);
